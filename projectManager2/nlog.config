<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      throwConfigExceptions="true">

  <!--
    כל בקשה נכנסת (Information, מ-CorrelationIdMiddleware), כל התנגשות על
    משאב (Warning, מ-ExceptionHandlingMiddleware) וכל חריגה אחרת שנתפסת
    (Error) נכתבים לכאן, יחד עם CorrelationId אחד שמזהה בקשה בודדת מקצה
    לקצה - כך שאפשר לשחזר "מה קרה בבקשה X" מתוך הקובץ בלבד.

    אין כאן ואסור שיהיה כאן: Body של בקשה, סיסמה, Token, או תוכן טופס
    הרשמה. קובץ Log הוא קובץ שאנשים קוראים.
  -->
  <targets>
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${scopeproperty:item=CorrelationId}|${message} ${exception:format=tostring}" />

    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${scopeproperty:item=CorrelationId}|${message}" />
  </targets>

  <rules>
    <!-- רעש של Framework פנימי (ASP.NET Core/EF Core) - רק מ-Warning ומעלה. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- כל שאר הקוד של האפליקציה (Controllers/Services/Middlewares): מ-Debug
         ומעלה, גם לקובץ הלוג וגם לקונסול. -->
    <logger name="*" minlevel="Debug" writeTo="file,console" />
  </rules>
</nlog>
